[Unit]
Description=RoceOS NAS Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/roceos
ExecStart=/opt/roceos/roceos
Restart=always
RestartSec=5
Environment=GIN_MODE=release
Environment=CONFIG_PATH=/opt/roceos/config.yaml
LimitNOFILE=65535
LimitNPROC=4096
StandardOutput=append:/var/log/roceos.log
StandardError=append:/var/log/roceos.log

[Install]
WantedBy=multi-user.target
